# Farmly Frontend Environment Configuration
# Copy this file to .env.local for local development.
# Everything prefixed NEXT_PUBLIC_ is visible in the browser: never put secrets here
# (no Pinata keys, no service-role key, no wallet keys; those belong in backend/.env).

# Application Information
NEXT_PUBLIC_APP_NAME=Farmly
NEXT_PUBLIC_APP_TAGLINE="The Digital Infrastructure for Modern Farming"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API base URL. Defaults to http://<current-host>:5000/api/v1 when empty.
NEXT_PUBLIC_API_URL=

# Supabase project used by the browser for sign-in (public anon key only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
