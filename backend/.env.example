PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase Connection
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only key for the certificate tables (Project Settings > API > service_role).
# Required for certificates, purchases and traceability. NEVER expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Demo logins (password-less demo accounts and demo_<role> tokens).
# Defaults to true outside production. Set to false for any shared or public deployment.
ALLOW_DEMO_AUTH=

# Base URL encoded in QR codes for public traceability pages (defaults to FRONTEND_URL).
PUBLIC_APP_URL=

# Pinata / IPFS (https://app.pinata.cloud > API Keys). Server-side only.
PINATA_JWT=
# Dedicated gateway domain, e.g. your-gateway.mypinata.cloud. Required to read private files.
PINATA_GATEWAY_URL=
CERT_MAX_FILE_MB=10

# Certificate registry contract (see contracts/README.md)
# Local Hardhat: http://127.0.0.1:8545 and chain id 31337. Sepolia: chain id 11155111.
CHAIN_RPC_URL=
CHAIN_ID=
CERT_REGISTRY_ADDRESS=
# Private key of an authorised registrar wallet. Use a dedicated testnet wallet; never a personal or mainnet key.
CHAIN_SIGNER_PRIVATE_KEY=
# Optional, for links in the UI, e.g. https://sepolia.etherscan.io/tx
CHAIN_EXPLORER_TX_URL=

# Phone crop registration (IVR) — see backend/src/ivr/README.md. All server-side only.
# Sarvam AI (https://dashboard.sarvam.ai): speech-to-text, translation and text-to-speech.
SARVAM_API_KEY=
# Optional bulbul:v3 voice (default: shubh)
IVR_TTS_SPEAKER=
# Offer Assamese and Urdu (recognised, but prompts use the Bengali / Hindi voice). Default: true
IVR_ENABLE_PARTIAL_LANGUAGES=
# Profile UUID of the helper account that phone registrations are filed under when no helper ran the call
IVR_HELPER_ID=
# Twilio (real calls). Leave empty to use only the free simulator at /helper/calls.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public HTTPS URL Twilio can reach (e.g. a cloudflared/ngrok tunnel), no trailing slash
IVR_PUBLIC_BASE_URL=
