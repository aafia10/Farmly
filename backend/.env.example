PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase Connection
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Pinata IPFS Configuration
# Get JWT or API Keys from https://app.pinata.cloud/developers/api-keys
PINATA_JWT=your-pinata-jwt-here
# Or use API Key pair if not using JWT:
PINATA_API_KEY=your-pinata-api-key
PINATA_SECRET_API_KEY=your-pinata-secret-api-key
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# Sepolia Ethereum Blockchain Configuration
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Private key of the deployer/authorized backend transaction sender wallet (without or with 0x prefix)
SEPOLIA_PRIVATE_KEY=your-sepolia-wallet-private-key
# Contract Address returned after deploying FarmlyBatchRegistry.sol in Remix
BATCH_REGISTRY_CONTRACT_ADDRESS=0xYourDeployedContractAddressHere
